# Required: Sierra API credentials
SIERRA_API_BASE=https://your-library.iii.com/iii/sierra-api/v6
SIERRA_CLIENT_KEY=your-api-key
SIERRA_CLIENT_SECRET=your-api-secret

# Recommended: Built-in admin account password
# Creates a local "admin" user that bypasses Sierra authentication.
# Required for initial setup and managing user roles via the admin UI.
# Without this, all Sierra users auto-provision with "viewer" role only.
# Password is synced to database on each startup (change env var to rotate).
SIERRA_AUTH_ADMIN_PASSWORD=change-this-to-a-secure-password

# Optional: Auth database path (default: ./sierra_auth.db)
# SIERRA_AUTH_DB_PATH=/data/sierra_auth.db

# Optional: Session cookie settings
# SIERRA_AUTH_COOKIE_NAME=ds_sierra_auth
# SIERRA_AUTH_COOKIE_MAX_AGE=86400

# Optional: Redirect after login (default: /)
# SIERRA_AUTH_LOGIN_REDIRECT=/
